# Ignore local env / venv / caches when building the API image
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.git/
frontend/node_modules/
frontend/dist/
storage/uploads/**
storage/results/**
storage/pipeline_runs/**
storage/diagrams/
storage/pages/
storage/work/
storage/queue_cache/
storage/cv_overlays/
storage/annotations/
storage/OCRResults/
storage/debug/
storage/pdfs/
exam_db.sqlite*
*.sqlite
# Docker ignore patterns do not cross '/', so the compose-persisted
# SQLite database needs its own entry or COPY . . bakes it into the image.
data/
New folder/
*.rar
graphify-out/
# The services never run the suite, but tests/fixtures is tracked and large
# (gold corpus plus the 2026 layout pages), so COPY . . would bake ~200MB of
# scans into every image. Nothing under backend/ imports these fixtures;
# gold_eval.py only names tests/fixtures/gold as a default for the offline
# eval scripts.
tests/
backend/examples/
