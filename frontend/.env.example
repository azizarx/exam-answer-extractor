# Vite API Base URL
#
# Local development (Vite on :3000, API on :8000):
VITE_API_BASE_URL=http://localhost:8000
#
# Production build: leave UNSET or empty so the UI calls the same HTTPS origin.
# Nginx must reverse-proxy API routes to the Python backend (see deploy/nginx-aimarker.conf).
# VITE_API_BASE_URL=
